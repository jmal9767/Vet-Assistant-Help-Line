// Reference Question schema for the current app.
// Not a full container export: merge with an exported schema before importing.
// World and Authenticated have no Question permissions. Operator membership is pending.
DEFINE SCHEMA

    CREATE ROLE Operator;

    RECORD TYPE Question (
        "___recordID" REFERENCE QUERYABLE,
        name STRING,
        email STRING,
        phone STRING,
        species STRING,
        age STRING,
        breed STRING,
        sex STRING,
        reproductiveStatus STRING,
        weight STRING,
        category STRING,
        urgency STRING,
        symptomOnset STRING,
        symptomTrend STRING,
        appetite STRING,
        drinking STRING,
        urination STRING,
        stool STRING,
        energy STRING,
        vomiting STRING,
        medicalHistory STRING,
        currentMedications STRING,
        actionsTaken STRING,
        question STRING,
        preferredReply STRING,
        requestedService STRING,
        petName STRING,
        attachmentSummary STRING,
        sourceChannel STRING,
        conversationStatus STRING,
        paymentStatus STRING,
        paymentMethod STRING,
        paymentAmount STRING,
        paymentLink STRING,
        signedConsentName STRING,
        signedConsentAt STRING,
        status STRING,
        submittedAt TIMESTAMP QUERYABLE SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT READ, WRITE TO Operator
    );
